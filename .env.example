# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Public host (Render) ---
WEBHOOK_BASE_URL=https://plan-app.onrender.com

# --- Database ---
# Supabase Postgres (https://supabase.com). Вставляй строку как есть,
# в libpq-формате — приложение само подставит async-драйвер
# (`app/db/base.py::_to_async_url` нормализует голый `postgresql://`
# в `postgresql+psycopg://`). Не пиши `+asyncpg`: asyncpg нет в
# зависимостях (в проекте `psycopg[binary]`) и он отвергает `sslmode`,
# а явный префикс проходит мимо нормализации → ModuleNotFoundError
# на старте. Явный `postgresql+psycopg://...` тоже допустим.
# postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# --- Groq ---
# Comma-separated list of Groq API keys (3+).
GROQ_API_KEYS=

# --- AI defaults ---
CRITIC_DEFAULT_MODE=confidence

# --- App ---
ENV=development
LOG_LEVEL=INFO
