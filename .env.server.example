# Настройки для self-hosted запуска (свой VPS, docker compose).
# Скопируй в .env рядом с docker-compose.yml и заполни два поля.
#
#   cp .env.server.example .env
#
# Всё остальное (режим бота, база, миграции) уже задано в
# docker-compose.yml — сюда попадают только секреты и личные настройки.

# ── Обязательно ─────────────────────────────────────────────────────

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Ключи Groq (LLM + распознавание речи), через запятую.
# Один ключ — тоже нормально; несколько дают запас по лимитам.
# Берутся на https://console.groq.com/keys
GROQ_API_KEYS=

# ── Необязательно ───────────────────────────────────────────────────

# Публичный HTTPS-адрес мини-аппы. Оставь пустым, если нужен только бот
# в переписке. Мини-апп требует HTTPS — нужен либо прокси провайдера
# (exe.dev/Fly/Railway публикуют порт по HTTPS сами), либо свой домен с
# Caddy/nginx, либо туннель. См. docs/SELF-HOSTING.md.
# MINIAPP_URL_OVERRIDE=https://plan.example.com/app/

# На каком адресе контейнер слушает порт 8000.
# 127.0.0.1 (по умолчанию) — только с самой машины.
# 0.0.0.0 — доступен по сети машины; нужно, когда порт публикует
# внешний прокси провайдера (панель «Proxy: Port N · public»).
# APP_BIND=0.0.0.0

# Сбор ошибок в Sentry. Пусто — SDK спит и никуда не ходит.
# SENTRY_DSN=

# Подробность логов: INFO по умолчанию, DEBUG — когда что-то отлаживаешь.
# LOG_LEVEL=INFO
