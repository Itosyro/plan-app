# Настройки для self-hosted запуска (свой VPS, docker compose).
# Скопируй в .env рядом с docker-compose.yml и заполни два поля.
#
#   cp .env.server.example .env
#
# Всё остальное (режим бота, база, миграции) уже задано в
# docker-compose.yml — сюда попадают только секреты и личные настройки.

# ── Обязательно ─────────────────────────────────────────────────────

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Ключи Groq (LLM + распознавание речи), через запятую.
# Один ключ — тоже нормально; несколько дают запас по лимитам.
# Берутся на https://console.groq.com/keys
GROQ_API_KEYS=

# Твой Telegram ID — кому бот отдаёт /backup (архив с этим файлом и
# базой, для переезда на другой сервер). Пусто — команда отключена;
# напиши боту /backup, он подскажет твой ID.
OWNER_TELEGRAM_ID=

# Как часто бот сам присылает такой архив, в часах. Страховка на случай,
# если сервер кончится раньше, чем вспомнишь про /backup. 0 — выключить.
# AUTO_BACKUP_HOURS=24

# Под каким uid:gid работает контейнер. База лежит в ./data на хосте, и
# если процесс внутри — не владелец этих файлов, он не сможет её открыть.
# scripts/install.sh проставляет их сам (id -u / id -g); руками — только
# если ставишь без скрипта. Без них берётся 1000:1000.
# PLAN_UID=1000
# PLAN_GID=1000

# ── Необязательно ───────────────────────────────────────────────────

# Публичный HTTPS-адрес мини-аппы. Оставь пустым, если нужен только бот
# в переписке. Мини-апп требует HTTPS — нужен либо прокси провайдера
# (exe.dev/Fly/Railway публикуют порт по HTTPS сами), либо свой домен с
# Caddy/nginx, либо туннель. См. docs/SELF-HOSTING.md.
# MINIAPP_URL_OVERRIDE=https://plan.example.com/app/

# На каком адресе контейнер слушает порт 8000.
# 127.0.0.1 (по умолчанию) — только с самой машины.
# 0.0.0.0 — доступен по сети машины; нужно, когда порт публикует
# внешний прокси провайдера (панель «Proxy: Port N · public»).
# При работе через маршрутизатор (ниже) менять НЕ надо: Caddy ходит
# по localhost, а наружу торчит только он.
# APP_BIND=0.0.0.0

# ── Маршрутизатор (когда публичный порт один на два проекта) ────────
# Запускается отдельно: docker compose --profile router up -d
# Подробности — docs/SELF-HOSTING.md, вариант 3.

# Порт, который занимает маршрутизатор (его указываешь в панели).
# ROUTER_PORT=3003

# Куда отдавать всё, кроме /app и /api — адрес соседнего проекта.
# NEIGHBOUR_UPSTREAM=127.0.0.1:3002

# Сбор ошибок в Sentry. Пусто — SDK спит и никуда не ходит.
# SENTRY_DSN=

# Подробность логов: INFO по умолчанию, DEBUG — когда что-то отлаживаешь.
# LOG_LEVEL=INFO
