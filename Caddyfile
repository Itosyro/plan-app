# Маршрутизатор на один публичный порт (см. docs/SELF-HOSTING.md, вариант 3).
#
# Зачем: некоторые хостинги (exe.dev и т.п.) публикуют наружу РОВНО ОДИН
# порт машины. Если этот порт уже занят соседним проектом, второй сервис
# опубликовать нечем. Caddy занимает публичный порт и делит трафик по
# путям: мини-апп забирает свои два префикса, всё остальное уходит
# соседу — тот продолжает работать по прежнему адресу и не замечает
# подмены.
#
# TLS здесь НЕ настраивается: сертификатом занимается прокси провайдера,
# внутрь приходит уже расшифрованный HTTP.
#
# Порты задаются переменными в .env:
#   ROUTER_PORT        — какой порт публикуется наружу (укажи его в панели)
#   NEIGHBOUR_UPSTREAM — куда отдавать всё остальное (соседний проект)

{
	# Админ-API Caddy не нужен и лишний раз слушать порт незачем.
	admin off
	# Логи — в stdout, их подхватывает docker с ротацией из compose.
	log {
		output stdout
		format console
	}
}

:{$ROUTER_PORT:3003} {
	# Мини-апп: страница и её ассеты. Пути жёстко заданы сборкой
	# (Vite base = /app/), поэтому префиксы именно такие.
	handle /app/* {
		reverse_proxy {$PLAN_UPSTREAM:127.0.0.1:8000}
	}

	# REST API мини-аппы.
	handle /api/* {
		reverse_proxy {$PLAN_UPSTREAM:127.0.0.1:8000}
	}

	# Всё остальное — соседнему проекту, ровно как было до маршрутизатора.
	handle {
		reverse_proxy {$NEIGHBOUR_UPSTREAM:127.0.0.1:3002}
	}
}
